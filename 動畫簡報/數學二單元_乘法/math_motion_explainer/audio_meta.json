  "voices": [
    {
      "frame": 1,
      "path": "assets/voice/01.wav",
      "source": "host",
      "speech_s": 25.393,
      "duration_s": 26.09,
      "words": [
        {
          "text": "遇到三位數除以二位數",
          "start": 0.0,
          "end": 2.073
        },
        {
          "text": "第一步先看商記在哪一位",
          "start": 2.365,
          "end": 4.37
        },
        {
          "text": "除數是二位數",
          "start": 5.333,
          "end": 6.654
        },
        {
          "text": "被除數就從左邊取兩位來比大小",
          "start": 6.92,
          "end": 9.577
        },
        {
          "text": "例如七百八十六除以二十四",
          "start": 10.553,
          "end": 12.938
        },
        {
          "text": "七十八大於二十四",
          "start": 13.256,
          "end": 14.889
        },
        {
          "text": "夠除",
          "start": 15.19,
          "end": 15.719
        },
        {
          "text": "商就從十位開始記",
          "start": 15.99,
          "end": 17.649
        },
        {
          "text": "如果是四百三十二除以五十四",
          "start": 17.96,
          "end": 20.468
        },
        {
          "text": "四十三小於五十四",
          "start": 20.725,
          "end": 22.34
        },
        {
          "text": "不夠除",
          "start": 22.605,
          "end": 23.3
        },
        {
          "text": "商就退到個位開始記",
          "start": 23.546,
          "end": 25.243
        }
      ]
    },
    {
      "frame": 2,
      "path": "assets/voice/02.wav",
      "source": "host",
      "speech_s": 18.873,
      "duration_s": 19.57,
      "words": [
        {
          "text": "第二步",
          "start": 0.0,
          "end": 0.688
        },
        {
          "text": "除數戴帽子",
          "start": 0.936,
          "end": 2.017
        },
        {
          "text": "化成最接近的整十來估商",
          "start": 2.321,
          "end": 4.325
        },
        {
          "text": "五十四戴上五十的帽子",
          "start": 5.269,
          "end": 7.083
        },
        {
          "text": "五八四十",
          "start": 7.361,
          "end": 8.238
        },
        {
          "text": "試商用八",
          "start": 8.522,
          "end": 9.445
        },
        {
          "text": "三十六戴上四十的帽子",
          "start": 9.765,
          "end": 11.713
        },
        {
          "text": "四七二十八",
          "start": 11.982,
          "end": 13.069
        },
        {
          "text": "試商用七",
          "start": 13.295,
          "end": 14.2
        },
        {
          "text": "善用九九乘法表",
          "start": 15.164,
          "end": 16.667
        },
        {
          "text": "一眼就能抓出可能的商",
          "start": 16.956,
          "end": 18.723
        }
      ]
    },
    {
      "frame": 3,
      "path": "assets/voice/03.wav",
      "source": "host",
      "speech_s": 20.827,
      "duration_s": 21.53,
      "words": [
        {
          "text": "第三步",
          "start": 0.0,
          "end": 0.724
        },
        {
          "text": "摘下帽子",
          "start": 0.991,
          "end": 1.861
        },
        {
          "text": "小心致命陷阱",
          "start": 2.157,
          "end": 3.412
        },
        {
          "text": "試出商之後",
          "start": 4.307,
          "end": 5.466
        },
        {
          "text": "計算直式乘法時",
          "start": 5.724,
          "end": 7.254
        },
        {
          "text": "一定要用原來的除數去乘商",
          "start": 7.583,
          "end": 9.732
        },
        {
          "text": "例如四百三十二除以五十四",
          "start": 10.678,
          "end": 13.139
        },
        {
          "text": "試商用八之後",
          "start": 13.434,
          "end": 14.691
        },
        {
          "text": "要算五十四乘以八等於四百三十二",
          "start": 15.007,
          "end": 17.874
        },
        {
          "text": "絕對不能算成五十乘八等於四百",
          "start": 18.154,
          "end": 20.677
        }
      ]
    },
    {
      "frame": 4,
      "path": "assets/voice/04.wav",
      "source": "host",
      "speech_s": 21.397,
      "duration_s": 23.2,
      "words": [
        {
          "text": "第四步",
          "start": 0.0,
          "end": 0.729
        },
        {
          "text": "調商天秤與驗算守則",
          "start": 0.993,
          "end": 2.684
        },
        {
          "text": "相乘後如果比被除數還大",
          "start": 2.684,
          "end": 5.842
        },
        {
          "text": "代表商太大",
          "start": 5.842,
          "end": 7.15
        },
        {
          "text": "要調小一",
          "start": 7.15,
          "end": 8.261
        },
        {
          "text": "如果減出來的餘數大於或等於除數",
          "start": 8.261,
          "end": 11.282
        },
        {
          "text": "代表商太小",
          "start": 11.538,
          "end": 12.557
        },
        {
          "text": "要調大一",
          "start": 12.825,
          "end": 14.58
        },
        {
          "text": "記住除法最高鐵律",
          "start": 14.58,
          "end": 16.173
        },
        {
          "text": "餘數必須比除數小",
          "start": 16.476,
          "end": 18.066
        },
        {
          "text": "最後用除數乘商加餘數完成驗算",
          "start": 18.379,
          "end": 21.247
        }
      ]
    }
  ],
